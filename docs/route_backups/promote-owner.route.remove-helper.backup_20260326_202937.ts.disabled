import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";
import { getServerSupabaseClient } from "@/lib/server/supabase";

function getServiceRoleClient() {
  const supabaseUrl =
    process.env.SUPABASE_URL ?? process.env.NEXT_PUBLIC_SUPABASE_URL;
  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl) {
    throw new Error("Missing Supabase URL");
  }

  if (!serviceRoleKey) {
    throw new Error("Missing SUPABASE_SERVICE_ROLE_KEY");
  }

  return createClient(supabaseUrl, serviceRoleKey, {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
      persistSessionInUrl: false as any,
    } as any,
  });
}

function toErrorInfo(err: unknown) {
  if (err instanceof Error) {
    const anyErr = err as any;
    return {
      debugMessage: err.message,
      debugName: err.name,
      debugCode: anyErr?.code ?? null,
      debugDetails: anyErr?.details ?? null,
      debugHint: anyErr?.hint ?? null,
      debugStack: process.env.NODE_ENV === "production" ? null : err.stack ?? null,
    };
  }

  return {
    debugMessage: String(err),
    debugName: "UnknownError",
    debugCode: null,
    debugDetails: null,
    debugHint: null,
    debugStack: null,
  };
}

export async function POST(req: Request) {
  try {
    const userSupabase = getServerSupabaseClient();

    const {
      data: { user },
      error: userError,
    } = await userSupabase.auth.getUser();

    if (userError || !user) {
      return NextResponse.json(
        {
          error: "unauthorized",
          userError: userError?.message ?? null,
        },
        { status: 401 }
      );
    }

    let payload: any = null;

    try {
      payload = await req.json();
    } catch (err) {
      return NextResponse.json(
        {
          error: "invalid_json",
          ...toErrorInfo(err),
        },
        { status: 400 }
      );
    }

    const tenantId = payload?.tenantId ?? payload?.tenant_id ?? null;
    const userIdToPromote =
      payload?.userIdToPromote ?? payload?.userId ?? payload?.user_id ?? null;

    if (!tenantId || !userIdToPromote) {
      return NextResponse.json(
        {
          error: "invalid_payload",
          receivedKeys: payload ? Object.keys(payload) : [],
          tenantId: tenantId ?? null,
          userIdToPromote: userIdToPromote ?? null,
        },
        { status: 400 }
      );
    }

    const { data: executorMembership, error: executorMembershipError } =
      await userSupabase
        .from("tenant_memberships")
        .select("tenant_id, user_id, role")
        .eq("tenant_id", tenantId)
        .eq("user_id", user.id)
        .single();

    if (executorMembershipError || !executorMembership) {
      return NextResponse.json(
        {
          error: "forbidden",
          stage: "executor_membership_lookup",
          executorMembershipError: executorMembershipError?.message ?? null,
        },
        { status: 403 }
      );
    }

    if (
      executorMembership.role !== "admin" &&
      executorMembership.role !== "owner"
    ) {
      return NextResponse.json(
        {
          error: "forbidden",
          stage: "executor_role_check",
          executorRole: executorMembership.role,
        },
        { status: 403 }
      );
    }

    const adminSupabase = getServiceRoleClient();

    const { data: targetMembership, error: targetMembershipError } =
      await adminSupabase
        .from("tenant_memberships")
        .select("tenant_id, user_id, role")
        .eq("tenant_id", tenantId)
        .eq("user_id", userIdToPromote)
        .single();

    if (targetMembershipError || !targetMembership) {
      return NextResponse.json(
        {
          error: "target_membership_not_found",
          stage: "target_membership_lookup",
          targetMembershipError: targetMembershipError?.message ?? null,
        },
        { status: 404 }
      );
    }

    const { data: updatedMembership, error: updateError } = await adminSupabase
      .from("tenant_memberships")
      .update({ role: "owner" })
      .eq("tenant_id", tenantId)
      .eq("user_id", userIdToPromote)
      .select("tenant_id, user_id, role")
      .single();

    if (updateError || !updatedMembership) {
      return NextResponse.json(
        {
          error: "update_failed",
          stage: "update_membership",
          updateErrorMessage: updateError?.message ?? null,
          updateErrorCode: (updateError as any)?.code ?? null,
          updateErrorDetails: (updateError as any)?.details ?? null,
          updateErrorHint: (updateError as any)?.hint ?? null,
        },
        { status: 500 }
      );
    }

    return NextResponse.json({
      success: true,
      tenantId: updatedMembership.tenant_id,
      promotedUserId: updatedMembership.user_id,
      newRole: updatedMembership.role,
    });
  } catch (err) {
    console.error("promote-owner internal error", err);

    return NextResponse.json(
      {
        error: "internal_error",
        stage: "top_level_catch",
        ...toErrorInfo(err),
      },
      { status: 500 }
    );
  }
}