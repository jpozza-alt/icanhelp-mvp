import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

function getUserClient(req: Request) {
  const supabaseUrl =
    process.env.SUPABASE_URL ?? process.env.NEXT_PUBLIC_SUPABASE_URL;

  const anonKey =
    process.env.SUPABASE_ANON_KEY ??
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

  if (!supabaseUrl || !anonKey) {
    throw new Error("Missing Supabase anon configuration");
  }

  const authHeader = req.headers.get("authorization") || "";
  const token = authHeader.replace(/^Bearer\s+/i, "").trim();

  if (!token) {
    throw new Error("Missing bearer token");
  }

  return createClient(supabaseUrl, anonKey, {
    global: {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    },
    auth: {
      persistSession: false,
      autoRefreshToken: false,
    },
  });
}

function getAdminClient() {
  const supabaseUrl =
    process.env.SUPABASE_URL ?? process.env.NEXT_PUBLIC_SUPABASE_URL;

  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl || !serviceRoleKey) {
    throw new Error("Missing service role config");
  }

  return createClient(supabaseUrl, serviceRoleKey, {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
    },
  });
}

export async function POST(req: Request) {
  try {
    const userSupabase = getUserClient(req);

    const {
      data: { user },
      error: userError,
    } = await userSupabase.auth.getUser();

    if (userError || !user) {
      return NextResponse.json(
        { error: "unauthorized", message: userError?.message ?? null },
        { status: 401 }
      );
    }

    let payload: any = null;

    try {
      payload = await req.json();
    } catch {
      return NextResponse.json({ error: "invalid_json" }, { status: 400 });
    }

    const tenantId = payload?.tenantId ?? payload?.tenant_id ?? null;

    const userIdToPromote =
      payload?.userIdToPromote ??
      payload?.userId ??
      payload?.user_id ??
      null;

    if (!tenantId || !userIdToPromote) {
      return NextResponse.json(
        {
          error: "invalid_payload",
          receivedKeys: payload ? Object.keys(payload) : [],
        },
        { status: 400 }
      );
    }

    const { data: executorMembership, error: executorError } = await userSupabase
      .from("tenant_memberships")
      .select("tenant_id, user_id, role")
      .eq("tenant_id", tenantId)
      .eq("user_id", user.id)
      .single();

    if (executorError || !executorMembership) {
      return NextResponse.json(
        {
          error: "forbidden",
          stage: "executor_membership_lookup",
          message: executorError?.message ?? null,
        },
        { status: 403 }
      );
    }

    if (executorMembership.role !== "admin" -and executorMembership.role -ne "owner") {
      return NextResponse.json(
        {
          error: "forbidden",
          stage: "executor_role_check",
          executorRole: executorMembership.role,
        },
        { status: 403 }
      );
    }

    const adminSupabase = getAdminClient();

    const { data: targetMembership, error: targetError } = await adminSupabase
      .from("tenant_memberships")
      .select("tenant_id, user_id, role")
      .eq("tenant_id", tenantId)
      .eq("user_id", userIdToPromote)
      .single();

    if (targetError || !targetMembership) {
      return NextResponse.json(
        {
          error: "target_not_found",
          stage: "target_membership_lookup",
          message: targetError?.message ?? null,
        },
        { status: 404 }
      );
    }

    const { data: updatedMembership, error: updateError } = await adminSupabase
      .from("tenant_memberships")
      .update({ role: "owner" })
      .eq("tenant_id", tenantId)
      .eq("user_id", userIdToPromote)
      .select("tenant_id, user_id, role")
      .single();

    if (updateError || !updatedMembership) {
      return NextResponse.json(
        {
          error: "update_failed",
          stage: "update_membership",
          message: updateError?.message ?? null,
          code: (updateError as any)?.code ?? null,
          details: (updateError as any)?.details ?? null,
          hint: (updateError as any)?.hint ?? null,
        },
        { status: 500 }
      );
    }

    return NextResponse.json({
      success: true,
      tenantId: updatedMembership.tenant_id,
      promotedUserId: updatedMembership.user_id,
      newRole: updatedMembership.role,
    });
  } catch (err: any) {
    return NextResponse.json(
      {
        error: "internal_error",
        stage: "top_level_catch",
        message: err?.message ?? String(err),
      },
      { status: 500 }
    );
  }
}