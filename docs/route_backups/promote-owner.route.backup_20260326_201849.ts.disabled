import { NextResponse } from "next/server";
import { getServerSupabaseClient } from "@/lib/server/supabase";
import { requireTenant } from "@/lib/db/requireTenant";

export async function POST(req: Request) {
  try {
    const supabase = getServerSupabaseClient();

    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      return NextResponse.json({ error: "unauthorized" }, { status: 401 });
    }

    const { tenantId, userIdToPromote } = await req.json();

    if (!tenantId || !userIdToPromote) {
      return NextResponse.json({ error: "invalid_payload" }, { status: 400 });
    }

    // valida tenant
    const tenant = await requireTenant(supabase, tenantId);

    // verifica role do executor
    const { data: membership } = await supabase
      .from("tenant_memberships")
      .select("role")
      .eq("user_id", user.id)
      .eq("tenant_id", tenantId)
      .single();

    if (!membership || membership.role !== "admin") {
      return NextResponse.json({ error: "forbidden" }, { status: 403 });
    }

    // promove usuário
    const { error: updateError } = await supabase
      .from("tenant_memberships")
      .update({ role: "owner" })
      .eq("user_id", userIdToPromote)
      .eq("tenant_id", tenantId);

    if (updateError) {
      return NextResponse.json({ error: "update_failed" }, { status: 500 });
    }

    return NextResponse.json({
      success: true,
      promotedUserId: userIdToPromote,
      tenantId,
    });
  } catch (err) {
    return NextResponse.json({ error: "internal_error" }, { status: 500 });
  }
}
