import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";
import { getServerSupabaseClient } from "@/lib/server/supabase";

function getServiceRoleClient() {
  const supabaseUrl =
    process.env.SUPABASE_URL ?? process.env.NEXT_PUBLIC_SUPABASE_URL;
  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl || !serviceRoleKey) {
    throw new Error("Missing Supabase service-role configuration");
  }

  return createClient(supabaseUrl, serviceRoleKey, {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
    },
  });
}

export async function POST(req: Request) {
  try {
    const userSupabase = getServerSupabaseClient();

    const {
      data: { user },
      error: userError,
    } = await userSupabase.auth.getUser();

    if (userError || !user) {
      return NextResponse.json({ error: "unauthorized" }, { status: 401 });
    }

    let payload: any = null;

    try {
      payload = await req.json();
    } catch {
      return NextResponse.json({ error: "invalid_json" }, { status: 400 });
    }

    const tenantId =
      payload?.tenantId ??
      payload?.tenant_id ??
      null;

    const userIdToPromote =
      payload?.userIdToPromote ??
      payload?.userId ??
      payload?.user_id ??
      null;

    if (!tenantId || !userIdToPromote) {
      return NextResponse.json({ error: "invalid_payload" }, { status: 400 });
    }

    const { data: executorMembership, error: executorMembershipError } =
      await userSupabase
        .from("tenant_memberships")
        .select("tenant_id, user_id, role")
        .eq("tenant_id", tenantId)
        .eq("user_id", user.id)
        .single();

    if (executorMembershipError || !executorMembership) {
      return NextResponse.json({ error: "forbidden" }, { status: 403 });
    }

    if (
      executorMembership.role !== "admin" &&
      executorMembership.role !== "owner"
    ) {
      return NextResponse.json({ error: "forbidden" }, { status: 403 });
    }

    const adminSupabase = getServiceRoleClient();

    const { data: targetMembership, error: targetMembershipError } =
      await adminSupabase
        .from("tenant_memberships")
        .select("tenant_id, user_id, role")
        .eq("tenant_id", tenantId)
        .eq("user_id", userIdToPromote)
        .single();

    if (targetMembershipError || !targetMembership) {
      return NextResponse.json(
        { error: "target_membership_not_found" },
        { status: 404 }
      );
    }

    const { data: updatedMembership, error: updateError } = await adminSupabase
      .from("tenant_memberships")
      .update({ role: "owner" })
      .eq("tenant_id", tenantId)
      .eq("user_id", userIdToPromote)
      .select("tenant_id, user_id, role")
      .single();

    if (updateError || !updatedMembership) {
      console.error("promote-owner update failed", {
        tenantId,
        executorUserId: user.id,
        targetUserId: userIdToPromote,
        updateError,
      });

      return NextResponse.json({ error: "update_failed" }, { status: 500 });
    }

    return NextResponse.json({
      success: true,
      tenantId: updatedMembership.tenant_id,
      promotedUserId: updatedMembership.user_id,
      newRole: updatedMembership.role,
    });
  } catch (err) {
    console.error("promote-owner internal error", err);

    return NextResponse.json({ error: "internal_error" }, { status: 500 });
  }
}